BootStrap: docker
From: ubuntu:24.04

%post
   apt-get -y update
   apt-get install --assume-yes wget unzip
   wget https://github.com/cvc5/cvc5/releases/download/cvc5-1.2.0/cvc5-Linux-x86_64-static.zip
   unzip cvc5-Linux-x86_64-static.zip

%environment
   export LC_ALL=C
   #export PATH=/usr/games:$PATH

%runscript
   /cvc5-Linux-x86_64-static/bin/cvc5 $*

%labels
   Author Alice
