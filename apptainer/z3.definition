BootStrap: docker
From: ubuntu:24.04

%post
   apt-get -y update
   apt-get install --assume-yes wget unzip
   wget https://github.com/Z3Prover/z3/releases/download/z3-4.13.4/z3-4.13.4-x64-glibc-2.35.zip
   unzip z3-4.13.4-x64-glibc-2.35.zip  

%environment
   export LC_ALL=C
   #export PATH=/usr/games:$PATH

%runscript
   /z3-4.13.4-x64-glibc-2.35/bin/z3 $*

%labels
   Author Alice
